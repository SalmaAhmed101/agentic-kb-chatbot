# Copy this file to .env and fill in your values. Never commit the real .env file.

# Required: your OpenAI (or OpenAI-compatible) API key
OPENAI_API_KEY=sk-...

# Optional: only set this if you're using an OpenAI-compatible provider
# (e.g. Azure OpenAI, a local proxy, OpenRouter, etc.)
# OPENAI_BASE_URL=https://api.your-provider.com/v1

# Optional: override default models
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
